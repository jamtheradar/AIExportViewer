@implements IDisposable
@inject LibrarySession Session
@inject ViewModeService View

<nav class="nav" aria-label="Main">
    <div class="brand">
        <span class="name"><img src="logo.svg" alt="" width="28" height="28" />AI Export Viewer</span>
        <small>Claude organisation export</small>
    </div>

    <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
    <NavLink href="download">Download an export</NavLink>
    <div class="section">Review</div>
    @if (!Session.IsReady)
    {
        <p class="nav-hint">Open an export from Home to use these.</p>
    }
    <NavLink href="overview" class="@Disabled">Overview</NavLink>
    <NavLink href="users" class="@Disabled">People</NavLink>
    <NavLink href="conversations" class="@Disabled">Conversations</NavLink>
    <NavLink href="projects" class="@Disabled">Projects</NavLink>
    <NavLink href="memories" class="@Disabled">What Claude remembers</NavLink>
    <NavLink href="artifacts" class="@Disabled">Documents &amp; pages</NavLink>
    @if (View.IsExpert)
    {
        <NavLink href="other" class="@Disabled">Other data</NavLink>
        <NavLink href="library" class="@Disabled">Files loaded</NavLink>
    }
    <NavLink href="search" class="@Disabled">Search</NavLink>
    <div class="section">Audit</div>
    <NavLink href="sensitive" class="@Disabled">Sensitive data</NavLink>
    <NavLink href="watchlists" class="@Disabled">Watchlists</NavLink>
    <NavLink href="flags" class="@Disabled">Flags and notes</NavLink>
    <div class="spacer"></div>
    <NavLink href="settings">Settings</NavLink>
</nav>

@code {
    private string Disabled => Session.IsReady ? "" : "disabled";

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        View.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        View.Changed -= OnChanged;
    }
}
