@inject NavigationManager Nav
@inject LibrarySession Session

@if (Items.Count == 0)
{
    <div class="empty">No conversations match these filters.</div>
}
else
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Conversation</th>
                    @if (ShowUser) { <th>Person</th> }
                    @if (Expert) { <th>Started</th> }
                    <th>Last message</th>
                    <th class="num">Messages</th>
                    <th>Details</th>
                    @if (Expert) { <th>ID</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Items)
                {
                    <tr class="clickable" @onclick="@(() => Nav.NavigateTo($"conversations/{c.Uuid}"))">
                        <td>
                            <a href="@($"conversations/{c.Uuid}")" @onclick:stopPropagation="true">@c.Title</a>
                            @if (_flagged.Contains(c.Uuid)) { <span class="flag-mark" title="You flagged this conversation or a message in it">⚑</span> }
                        </td>
                        @if (ShowUser) { <td class="nowrap">@(c.UserName ?? "Unknown person")</td> }
                        @if (Expert) { <td class="small">@Fmt.Date(c.FirstMessageAt, ViewMode.Expert)</td> }
                        <td class="@(Expert ? "small" : "nowrap")">@Fmt.Date(c.LastMessageAt, Expert ? ViewMode.Expert : ViewMode.Basic)</td>
                        <td class="num">
                            @Fmt.N(c.MessageCount)
                            @if (Expert && c.TotalMessages != c.MessageCount) { <span class="muted small"> / @Fmt.N(c.TotalMessages)</span> }
                        </td>
                        <td>
                            <div style="display:flex;gap:.3rem;flex-wrap:wrap">
                                <StatusBadge Severity="c.Integrity" />
                                @if (c.Traits.HasFlag(MessageTraits.HasAttachments) || c.Traits.HasFlag(MessageTraits.HasFiles)) { <span class="tag" title="Someone attached or uploaded a file">Has files</span> }
                                @if (c.Traits.HasFlag(MessageTraits.HasToolUse)) { <span class="tag" title="Claude searched the web or used another tool">Used tools</span> }
                                @if (c.ForkCount > 0) { <span class="tag" title="Messages were edited or replies retried">Edited</span> }
                            </div>
                        </td>
                        @if (Expert) { <td class="mono small">@c.Uuid[..Math.Min(8, c.Uuid.Length)]</td> }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ConversationListItem> Items { get; set; } = [];
    [Parameter] public bool ShowUser { get; set; } = true;
    [Parameter] public bool Expert { get; set; }

    private IReadOnlySet<string> _flagged = new HashSet<string>();

    protected override void OnParametersSet() =>
        _flagged = Session.IsReady ? Session.Reviews.FlaggedConversations() : new HashSet<string>();
}
