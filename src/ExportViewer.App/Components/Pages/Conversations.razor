@page "/conversations"
@inherits PageBase

<div class="page-head">
    <div>
        <h1>Conversations</h1>
        <p class="subtle">Every conversation in the export. Click one to read it.</p>
    </div>
</div>

<div class="filters" role="search">
    <label>Person
        <select @bind="_user" @bind:after="Apply">
            <option value="">Everyone</option>
            @foreach (var u in _users)
            {
                <option value="@u.Uuid">@u.DisplayName</option>
            }
        </select>
    </label>
    <label>From <input type="date" @bind="_from" @bind:after="Apply" /></label>
    <label>To <input type="date" @bind="_to" @bind:after="Apply" /></label>
    <label>Title contains <input type="text" @bind="_title" @bind:event="oninput" @bind:after="Apply" placeholder="Any" /></label>
    <div class="filter-links">
        <button class="link" @onclick="() => _more = !_more" aria-expanded="@(_more ? "true" : "false")">@(_more ? "Fewer filters" : "More filters")@(HiddenActive > 0 ? $" ({HiddenActive} on)" : "")</button>
        @if (AnyActive) { <button class="link" @onclick="Clear">Clear filters</button> }
    </div>
</div>
@if (_more)
{
    <div class="filters more-filters">
        <label>Missing replies
            <select @bind="_flag" @bind:after="Apply">
                <option value="0">Show all</option>
                <option value="3">Ends without Claude's reply</option>
                <option value="2">Has an empty reply</option>
                @if (Expert) { <option value="1">Any export note</option> }
            </select>
        </label>
        <label>Sort
            <select @bind="_sort" @bind:after="Apply">
                <option value="@ConversationSort.Newest">Newest first</option>
                <option value="@ConversationSort.Oldest">Oldest first</option>
                <option value="@ConversationSort.Longest">Longest first</option>
                <option value="@ConversationSort.Shortest">Shortest first</option>
                <option value="@ConversationSort.TitleAz">Title A–Z</option>
            </select>
        </label>
        <label class="check"><input type="checkbox" @bind="_files" @bind:after="Apply" /> Has attachments or files</label>
        <label class="check"><input type="checkbox" @bind="_tools" @bind:after="Apply" /> Claude searched the web or used tools</label>
        <label class="check"><input type="checkbox" @bind="_edited" @bind:after="Apply" /> A message was edited or retried</label>
    </div>
}

<ConversationTable Items="_items" Expert="Expert" />
<Pager Total="_total" Offset="_offset" OffsetChanged="Page" />

@code {
    [SupplyParameterFromQuery(Name = "user")] public string? UserParam { get; set; }
    [SupplyParameterFromQuery(Name = "flag")] public int? FlagParam { get; set; }

    private IReadOnlyList<UserSummary> _users = [];
    private IReadOnlyList<ConversationListItem> _items = [];
    private int _total, _offset;
    private string _user = "";
    private DateTime? _from, _to;
    private string _title = "";
    private int _flag;
    private ConversationSort _sort;
    private bool _files, _tools, _edited;
    private string? _appliedParams;
    private bool _more;

    /// <summary>Filters tucked under "More filters" that are switched on.</summary>
    private int HiddenActive => (_flag != 0 ? 1 : 0) + (_sort != ConversationSort.Newest ? 1 : 0) + (_files ? 1 : 0) + (_tools ? 1 : 0) + (_edited ? 1 : 0);

    private bool AnyActive => HiddenActive > 0 || _user.Length > 0 || _from is not null || _to is not null || _title.Length > 0;

    private void Clear()
    {
        _user = _title = "";
        _from = _to = null;
        _flag = 0;
        _sort = ConversationSort.Newest;
        _files = _tools = _edited = false;
        Apply();
    }

    private sealed record Place(string User, DateTime? From, DateTime? To, string Title, int Flag, ConversationSort Sort,
        bool Files, bool Tools, bool Edited, int Offset, string? AppliedParams);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Recall<Place>("conversations") is not { } p) return;
        (_user, _from, _to, _title, _flag, _sort) = (p.User, p.From, p.To, p.Title, p.Flag, p.Sort);
        (_files, _tools, _edited, _offset, _appliedParams) = (p.Files, p.Tools, p.Edited, p.Offset, p.AppliedParams);
    }

    protected override void SavePlace() =>
        Remember("conversations", new Place(_user, _from, _to, _title, _flag, _sort, _files, _tools, _edited, _offset, _appliedParams));

    protected override void OnParametersSet()
    {
        var key = $"{UserParam}|{FlagParam}";
        if (key != _appliedParams)
        {
            // Opened from a link with its own filters (such as a person's "see all conversations").
            _appliedParams = key;
            _user = UserParam ?? "";
            _flag = FlagParam ?? 0;
            _from = _to = null;
            _title = "";
            _files = _tools = _edited = false;
            _offset = 0;
        }
        // Filters that are on stay visible, so the list is never narrowed by something the reviewer can't see.
        _more |= HiddenActive > 0;
        base.OnParametersSet();
    }

    protected override void LoadData()
    {
        _users = Session.Queries.GetUsers();
        Query();
    }

    private void Apply()
    {
        _offset = 0;
        Query();
    }

    private void Page(int offset)
    {
        _offset = offset;
        Query();
    }

    private void Query()
    {
        if (!Session.IsReady) return;
        var filter = new ConversationFilter(
            AccountUuid: _user.Length == 0 ? null : _user,
            From: _from is { } f ? new DateTimeOffset(f.Date, TimeZoneInfo.Local.GetUtcOffset(f.Date)) : null,
            To: _to is { } t ? new DateTimeOffset(t.Date.AddDays(1), TimeZoneInfo.Local.GetUtcOffset(t.Date)) : null,
            TitleContains: _title,
            HasAttachments: _files,
            HasToolUse: _tools,
            HasBranches: _edited,
            MinIntegrity: (Severity)_flag,
            Sort: _sort,
            Limit: 50,
            Offset: _offset);
        (_total, _items) = Session.Queries.GetConversations(filter);
        if (ClampOffset(_offset, _total, 50) is var clamped && clamped != _offset)
        {
            _offset = clamped;
            Query();
        }
    }
}
