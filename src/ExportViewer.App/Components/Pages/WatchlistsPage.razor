@page "/watchlists"
@inherits PageBase
@inject AuditService Audit

<div class="page-head">
    <div>
        <h1>Watchlists</h1>
        <p class="subtle">Lists of words to look for, such as client names, project codes or confidential topics.
            They are saved on this computer only and can be used with any export you open.</p>
    </div>
    <ExportButtons Build="@(_ => BuildReport())" Kind="watchlist" Disabled="@(_total == 0)" />
</div>

<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap">
        <h2 style="margin:0">Your lists</h2>
        <button @onclick="New" disabled="@(_editing is not null)">Add a watchlist</button>
    </div>

    @if (Audit.Watchlists.Count == 0 && _editing is null)
    {
        <p class="subtle">No watchlists yet. Add one with the names or words you want to find, one per line.</p>
    }
    else if (Audit.Watchlists.Count > 0)
    {
        <div class="table-wrap" style="margin-top:.6rem">
            <table class="data">
                <thead><tr><th>Name</th><th class="num">Words</th><th class="num">Matches</th><th></th></tr></thead>
                <tbody>
                    @foreach (var w in Audit.Watchlists)
                    {
                        var list = w;
                        <tr>
                            <td>
                                <strong>@(list.Name.Length > 0 ? list.Name : "(unnamed)")</strong>
                                @if (list.Patterns) { <span class="tag" style="margin-left:.4rem">Patterns</span> }
                                <div class="small muted">@Preview(list)</div>
                            </td>
                            <td class="num">@Fmt.N(list.ActiveTerms.Count())</td>
                            <td class="num">@Fmt.N(_counts.Where(c => c.ListId == list.Id).Sum(c => c.Count))</td>
                            <td class="num nowrap">
                                <button @onclick="() => Edit(list)" disabled="@(_editing is not null)">Edit</button>
                                <button class="link" style="margin-left:.6rem" @onclick="() => _confirmDelete = list">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_editing is { } e)
    {
        <div class="editor">
            <h3>@(Audit.Watchlists.Any(w => w.Id == e.Id) ? "Edit watchlist" : "New watchlist")</h3>
            <div class="filters" style="margin-bottom:.6rem">
                <label style="flex:1;min-width:260px">Name <input type="text" @bind="e.Name" @bind:event="oninput" placeholder="For example: Clients" /></label>
            </div>
            <label class="small" for="watch-terms">Words to look for, one per line</label>
            <textarea id="watch-terms" rows="8" style="width:100%" class="mono" @bind="_terms" @bind:event="oninput" @bind:after="Validate"
                      placeholder="Acme Pty Ltd&#10;Project Bluegum&#10;QX-1042"></textarea>
            <p class="small muted">Matching ignores capitals and only matches whole words, so “Acme” finds “ACME” but not “Acmeville”.</p>
            <label class="check" style="display:flex;gap:.5rem;align-items:flex-start;margin:.4rem 0">
                <input type="checkbox" @bind="e.Patterns" @bind:after="Validate" />
                <span>Treat each line as a pattern (regular expression). <span class="muted small">For advanced users. A pattern that takes too long is stopped and reported.</span></span>
            </label>
            @if (_errors.Count > 0)
            {
                <div class="banner medium">
                    <strong>@Fmt.Plural(_errors.Count, "line can't", "lines can't") be used:</strong>
                    <ul>@foreach (var err in _errors) { <li>Line @err.Line, <span class="mono">@err.Term</span>: @err.Message</li> }</ul>
                </div>
            }
            <div style="display:flex;gap:.5rem;margin-top:.6rem">
                <button class="primary" @onclick="Save" disabled="@(string.IsNullOrWhiteSpace(e.Name) || string.IsNullOrWhiteSpace(_terms) || _errors.Count > 0)">Save</button>
                <button @onclick="() => _editing = null">Cancel</button>
            </div>
        </div>
    }
</div>

<h2>Matches in this export</h2>
<ScanPanel />

@if (_hasRun)
{
    <div class="filters" role="search" style="margin-top:1rem">
        <label>Watchlist
            <select @bind="_list" @bind:after="Apply">
                <option value="">All lists</option>
                @foreach (var w in Audit.Watchlists) { <option value="@w.Id">@w.Name</option> }
            </select>
        </label>
        <label>Person
            <select @bind="_user" @bind:after="Apply">
                <option value="">Everyone</option>
                @foreach (var u in _users) { <option value="@u.Uuid">@u.DisplayName</option> }
            </select>
        </label>
        <label>From <input type="date" @bind="_from" @bind:after="Apply" /></label>
        <label>To <input type="date" @bind="_to" @bind:after="Apply" /></label>
    </div>
    <FindingsTable Rows="_rows" Watchlist="true" Expert="Expert"
                   EmptyText="@(Audit.Watchlists.Count == 0 ? "Add a watchlist, then check the export." : "No matches.")" />
    <Pager Total="_total" Offset="_offset" OffsetChanged="Page" />
}

@if (_confirmDelete is { } del)
{
    <div class="overlay" role="dialog" aria-modal="true">
        <div class="dialog">
            <h2>Delete the “@del.Name” watchlist?</h2>
            <p>Its words are removed from this computer. Matches already found stay listed until the next check.</p>
            <div class="actions">
                <button @onclick="() => _confirmDelete = null">Cancel</button>
                <button class="danger" @onclick="() => { Audit.Delete(del.Id); _confirmDelete = null; }">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _hasRun;
    private IReadOnlyList<FindingCount> _counts = [];
    private IReadOnlyList<UserSummary> _users = [];
    private IReadOnlyList<FindingRow> _rows = [];
    private int _total, _offset;
    private string _list = "", _user = "";
    private DateTime? _from, _to;
    private int _auditVersion = -1;

    private Watchlist? _editing;
    private string _terms = "";
    private IReadOnlyList<WatchlistError> _errors = [];
    private Watchlist? _confirmDelete;

    private sealed record Place(string List, string User, DateTime? From, DateTime? To, int Offset);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Audit.Changed += OnAuditChanged;
        if (Recall<Place>("watchlists") is { } p)
            (_list, _user, _from, _to, _offset) = (p.List, p.User, p.From, p.To, p.Offset);
    }

    protected override void SavePlace() => Remember("watchlists", new Place(_list, _user, _from, _to, _offset));

    protected override void LoadData()
    {
        _auditVersion = Audit.Version;
        _users = Session.Queries.GetUsers();
        _hasRun = Session.Audit.GetScanInfo().HasRun;
        _counts = Session.Audit.GetCounts(FindingSource.Watchlist);
        Query();
    }

    private void OnAuditChanged() => InvokeAsync(() =>
    {
        if (Audit.Running || Audit.Version == _auditVersion || !Session.IsReady) return;
        LoadData();
        StateHasChanged();
    });

    private static string Preview(Watchlist w)
    {
        var terms = w.ActiveTerms.Take(6).ToList();
        var more = w.ActiveTerms.Count() - terms.Count;
        return string.Join(", ", terms) + (more > 0 ? $" and {more} more" : "");
    }

    private void New()
    {
        _editing = new Watchlist();
        _terms = "";
        _errors = [];
    }

    private void Edit(Watchlist w)
    {
        _editing = new Watchlist { Id = w.Id, Name = w.Name, Patterns = w.Patterns, Terms = w.Terms.ToList() };
        _terms = string.Join("\n", w.Terms);
        Validate();
    }

    private void Validate()
    {
        if (_editing is null) return;
        _editing.Terms = _terms.Split('\n').Select(t => t.TrimEnd('\r')).ToList();
        _errors = WatchlistMatcher.Validate(_editing);
    }

    private void Save()
    {
        if (_editing is null) return;
        Validate();
        _editing.Name = _editing.Name.Trim();
        _editing.Terms = _editing.Terms.Select(t => t.Trim()).Where(t => t.Length > 0).ToList();
        Audit.Save(_editing);
        _editing = null;
    }

    private void Apply()
    {
        _offset = 0;
        Query();
    }

    private void Page(int offset)
    {
        _offset = offset;
        Query();
    }

    private FindingFilter Filter(int limit, int offset) => new(
        FindingSource.Watchlist,
        ListId: _list.Length == 0 ? null : _list,
        AccountUuid: _user.Length == 0 ? null : _user,
        From: _from is { } f ? new DateTimeOffset(f.Date, TimeZoneInfo.Local.GetUtcOffset(f.Date)) : null,
        To: _to is { } t ? new DateTimeOffset(t.Date.AddDays(1), TimeZoneInfo.Local.GetUtcOffset(t.Date)) : null,
        Limit: limit,
        Offset: offset);

    private void Query()
    {
        if (!Session.IsReady) return;
        (_total, _rows) = Session.Audit.GetFindings(Filter(50, _offset));
        if (ClampOffset(_offset, _total, 50) is var clamped && clamped != _offset)
        {
            _offset = clamped;
            Query();
        }
    }

    private Report BuildReport()
    {
        var (total, rows) = Session.Audit.GetFindings(Filter(5000, 0));
        var filters = new List<(string, string)>
        {
            ("Watchlists", _list.Length == 0 ? string.Join(", ", Audit.Watchlists.Select(w => w.Name)) : Audit.Watchlists.FirstOrDefault(w => w.Id == _list)?.Name ?? ""),
        };
        if (_user.Length > 0) filters.Add(("Person", _users.FirstOrDefault(u => u.Uuid == _user)?.DisplayName ?? _user));
        if (_from is not null || _to is not null) filters.Add(("Dates", $"{_from:d MMM yyyy} to {_to:d MMM yyyy}".Trim()));
        return ReportBuilder.Findings(Session.ReportContext(), FindingSource.Watchlist, rows, total, Session.Audit.GetScanInfo(), filters);
    }

    public override void Dispose()
    {
        Audit.Changed -= OnAuditChanged;
        base.Dispose();
    }
}
