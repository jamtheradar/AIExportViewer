<Project>
  <!--
    Privacy rule: PDFsharp ships helper assemblies that use HttpClient (signature timestamping, test tools).
    The app never uses them and nothing it uses depends on them, so they are left out of every build.
    PrivacyGuardTests checks they stay out.
  -->
  <Target Name="RemoveNetworkCapablePdfAssemblies" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)"
        Condition="'%(Filename)' == 'PdfSharp.Cryptography' or '%(Filename)' == 'PdfSharp.Quality' or '%(Filename)' == 'PdfSharp.Snippets'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)"
        Condition="'%(Filename)' == 'PdfSharp.Cryptography' or '%(Filename)' == 'PdfSharp.Quality' or '%(Filename)' == 'PdfSharp.Snippets'" />
    </ItemGroup>
  </Target>
</Project>
